{
  "name": "@qiankunjs/sandbox",
  "version": "0.0.1-rc.17",
  "description": "qiankun sandbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../vite.library.config.ts && tsc -p tsconfig.build.json && node ../../scripts/copy-declarations.mjs src dist/esm && node ../../scripts/copy-declarations.mjs dist/esm dist/cjs",
    "test": "vitest --run"
  },
  "files": [
    "dist"
  ],
  "author": "Kuitos",
  "license": "MIT",
  "dependencies": {
    "@qiankunjs/shared": "workspace:^",
    "lodash": "^4.18.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
