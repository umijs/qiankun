{
  "name": "@qiankunjs/shared",
  "version": "0.0.1-rc.13",
  "description": "internal shared package for qiankun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../vite.library.config.ts && tsc -p tsconfig.build.json && node ../../scripts/copy-declarations.mjs src dist/esm && node ../../scripts/copy-declarations.mjs dist/esm dist/cjs",
    "test": "vitest --run"
  },
  "author": "Kuitos",
  "license": "MIT",
  "dependencies": {
    "compare-versions": "^6.1.1",
    "es-module-lexer": "^2.3.1",
    "lodash": "^4.18.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
