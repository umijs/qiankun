{
  "name": "@qiankunjs/shared",
  "version": "0.1.0-rc.14",
  "description": "internal shared package for qiankun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git",
    "directory": "packages/shared"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../vite.library.exports.config.ts",
    "test": "vitest --run"
  },
  "author": "Kuitos",
  "license": "MIT",
  "dependencies": {
    "compare-versions": "^6.1.1",
    "es-module-lexer": "^2.3.1",
    "lodash": "^4.18.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "homepage": "https://www.qiankunjs.com",
  "bugs": {
    "url": "https://github.com/umijs/qiankun/issues"
  }
}
