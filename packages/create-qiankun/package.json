{
  "name": "create-qiankun",
  "version": "0.0.1-rc.2",
  "description": "Scaffold a qiankun main app or sub app with a single command",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git"
  },
  "bin": {
    "create-qiankun": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite build --watch --config ../../vite.library.config.ts",
    "build": "rimraf dist && vite build --config ../../vite.library.config.ts && tsc -p tsconfig.build.json && node ../../scripts/copy-declarations.mjs src dist",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "qiankun",
    "micro-frontend",
    "vite",
    "scaffold"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "create-vite": "^9.1.1",
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  }
}
