{
  "name": "@qiankunjs/ui-shared",
  "version": "0.1.0-rc.2",
  "description": "ui binding shared for qiankun",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../../vite.library.exports.config.ts",
    "dev": "vite build --watch --config ../../../vite.library.config.ts",
    "test": "vitest --run"
  },
  "author": "linghaoSu",
  "license": "MIT",
  "dependencies": {
    "@qiankunjs/single-spa": "workspace:^",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "qiankun": "workspace:^"
  },
  "peerDependencies": {
    "qiankun": "^3.0.0-rc.15"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git",
    "directory": "packages/ui-bindings/shared"
  },
  "homepage": "https://www.qiankunjs.com",
  "bugs": {
    "url": "https://github.com/umijs/qiankun/issues"
  }
}
