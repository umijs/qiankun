{
  "name": "@qiankunjs/vue",
  "version": "0.0.1-rc.3",
  "description": "vue binding for qiankun",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../../vite.library.exports.config.ts",
    "dev": "vite build --watch --config ../../../vite.library.config.ts",
    "test": "vitest --run"
  },
  "author": "linghaoSu",
  "license": "MIT",
  "dependencies": {
    "@qiankunjs/ui-shared": "workspace:^",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "qiankun": "workspace:^",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.2",
    "qiankun": "^3.0.0-rc.15",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umijs/qiankun.git",
    "directory": "packages/ui-bindings/vue"
  },
  "homepage": "https://www.qiankunjs.com",
  "bugs": {
    "url": "https://github.com/umijs/qiankun/issues"
  }
}
