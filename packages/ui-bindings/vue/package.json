{
  "name": "@qiankunjs/vue",
  "version": "0.0.1-rc.2",
  "description": "vue binding for qiankun",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && vite build --config ../../../vite.library.config.ts && tsc -p tsconfig.build.json && node ../../../scripts/copy-declarations.mjs src dist/esm && node ../../../scripts/copy-declarations.mjs dist/esm dist/cjs",
    "dev": "vite build --watch --config ../../../vite.library.config.ts"
  },
  "author": "linghaoSu",
  "license": "MIT",
  "dependencies": {
    "@qiankunjs/ui-shared": "workspace:^",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "qiankun": "workspace:^",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "@vue/composition-api": "^1.7.2",
    "qiankun": "^3.0.0-rc.15",
    "vue": "^2.0.0 || >=3.0.0"
  },
  "peerDependenciesMeta": {
    "@vue/composition-api": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "repository": "git@github.com:umijs/qiankun.git"
}
