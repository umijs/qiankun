{
  // extend your base config to share compilerOptions, etc
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // ensure that nobody can accidentally use this config for a build
    "noEmit": true
  },
  "include": [
    // whatever paths you intend to lint
    "packages/*/src",
    "packages/ui-bindings/*/src",
    "vitest.workspace.ts",
    "vitest.config.ts",
    ".fatherrc.js"
  ],
  // bundler-plugin ships a vite plugin whose types need moduleResolution: bundler — its own
  // tsconfig (src + tests) takes over for linting
  "exclude": ["packages/bundler-plugin"]
}
